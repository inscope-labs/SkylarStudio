<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 4: Platform-level access control for Capability Targets -->
    <permission
        android:name="com.inscopelabs.abx.skylar.permission.DISPATCH_CAPABILITY"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.inscopelabs.abx.skylar.permission.DISPATCH_CAPABILITY" />

    <application
        android:name=".SkylarApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skylar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Skylar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".diagnostics.CrashActivity"
            android:exported="false"
            android:label="@string/crash_title"
            android:process=":crash"
            android:theme="@style/Theme.Skylar" />
        <activity
            android:name=".diagnostics.UserFacingErrorActivity"
            android:exported="false"
            android:label="@string/error_user_title"
            android:process=":crash"
            android:theme="@style/Theme.Skylar" />

        <!-- Phase 4: IN-PROCESS MOCKS ONLY — not the real Starlight/SFM apps.
             See docs/skylar-phase-04-real-integration-requirements.md.
             Platform-level access control (signature permission) is real
             and correctly configured below, but these services are not a
             substitute for genuinely separate installed apps. -->
        <service
            android:name=".ipc.target.mock.MockStarlightTargetService"
            android:exported="true"
            android:permission="com.inscopelabs.abx.skylar.permission.DISPATCH_CAPABILITY">
            <intent-filter>
                <action android:name="com.inscopelabs.abx.skylar.action.BIND_STARLIGHT" />
            </intent-filter>
        </service>

        <service
            android:name=".ipc.target.mock.MockSfmTargetService"
            android:exported="true"
            android:permission="com.inscopelabs.abx.skylar.permission.DISPATCH_CAPABILITY">
            <intent-filter>
                <action android:name="com.inscopelabs.abx.skylar.action.BIND_SFM" />
            </intent-filter>
        </service>
    </application>

</manifest>
